#!/usr/bin/env bash
#
# pilo - flash a universal_gauges build variant onto an RP2040 in BOOTSEL mode
#
#   usage: pilo <variant>
#          pilo                 # lists the available variants
#
#   variants: oil_t    engine oil temperature   (main_oil_t.uf2)
#             gearbox_t  gearbox oil temperature  (main_gearbox_t.uf2)
#             oil_p    engine oil pressure      (main_oil_p.uf2)
#
#   Add _demo for a demo image, the one built with cmake -DUSE_DEMO=ON, whose
#   needle sweeps the face on its own instead of following the sensor:
#          pilo oil_p_demo                     (main_oil_p_demo.uf2)
#
#   A .uf2 file name or path is also accepted directly:
#          pilo build/main_oil_p.uf2
#
#   Environment overrides:
#     PILO_BUS=1 PILO_ADDRESS=5   target one specific device (several boards
#                                 in BOOTSEL at once)
#     PILO_SUDO=0|1               force sudo off/on (default: on for Linux)
#
set -uo pipefail

VARIANTS="oil_t gearbox_t oil_p"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

die() { printf '%s\n' "$*" >&2; exit 1; }

# ---- locate a .uf2 for the requested target --------------------------------
# Takes a target name: oil_t, or oil_t_demo for a demo image. Normal builds
# land in build/, demo builds in build-demo/ if that is where they were
# configured, but either directory can hold either, so both are searched.
# Release downloads are flashed by passing their path directly.
find_uf2() {
  local d
  for d in "$ROOT/build" "$ROOT/build-demo"; do
    [ -f "$d/main_$1.uf2" ] && { printf '%s\n' "$d/main_$1.uf2"; return 0; }
  done
  return 1
}

# lists one group of targets: the plain variants, or their demo counterparts
list_targets() {
  local suffix="$1" v f
  for v in $VARIANTS; do
    if f="$(find_uf2 "$v$suffix")"; then
      printf '  %-16s %s\n' "$v$suffix" "$f"
    else
      printf '  %-16s (not built)\n' "$v$suffix"
    fi
  done
}

usage() {
  echo "usage: pilo <variant>"
  echo
  echo "available variants:"
  list_targets ""
  echo
  echo "demo images - the needle sweeps on its own, the sensor is ignored"
  echo "(built with: cmake -DUSE_DEMO=ON ..):"
  list_targets "_demo"
  echo
  echo "a .uf2 file or path also works:  pilo build/main_oil_p.uf2"
}

[ $# -eq 0 ] && { usage; exit 1; }

# ---- resolve the argument to a .uf2 path ----------------------------------
ARG="$1"
UF2=""

case "$ARG" in
  -h|--help) usage; exit 0 ;;
  *.uf2)
    # explicit file: as given, or relative to the project root
    if   [ -f "$ARG" ];        then UF2="$ARG"
    elif [ -f "$ROOT/$ARG" ];  then UF2="$ROOT/$ARG"
    else die "pilo: no such file: $ARG"
    fi
    ;;
  *)
    # accept oil_p as well as main_oil_p, and oil_p_demo for a demo image
    NAME="${ARG#main_}"
    BASE="${NAME%_demo}"
    case " $VARIANTS " in
      *" $BASE "*) ;;
      *) echo "pilo: unknown variant '$ARG'" >&2; echo >&2; usage >&2; exit 1 ;;
    esac
    if ! UF2="$(find_uf2 "$NAME")"; then
      if [ "$NAME" != "$BASE" ]; then
        die "pilo: main_$NAME.uf2 not found - build it with:
       mkdir build-demo && cd build-demo && cmake -DUSE_DEMO=ON .. && make"
      fi
      die "pilo: main_$NAME.uf2 not found - build it first (cmake --build build)"
    fi
    ;;
esac

# ---- warn on a stale build ------------------------------------------------
# The firmware is a handful of modules, so this looks at all of them, at the
# libraries and at the generated image headers, not just at main.c.
STALE=""
for src in "$ROOT"/*.c "$ROOT"/*.h "$ROOT"/CMakeLists.txt \
           "$ROOT"/lib/*.c "$ROOT"/lib/*.h "$ROOT"/lib/*/*.c "$ROOT"/lib/*/*.h \
           "$ROOT"/img/*.h; do
  [ -f "$src" ] && [ "$src" -nt "$UF2" ] && STALE="$STALE $(basename "$src")"
done
[ -n "$STALE" ] && \
  echo "pilo: warning -$STALE newer than $(basename "$UF2"), rebuild?" >&2

case "$(basename "$UF2")" in
  *_demo.uf2)
    echo "pilo: this is a demo image - the needle sweeps, the sensor is ignored" >&2
    ;;
esac

# ---- picotool -------------------------------------------------------------
command -v picotool >/dev/null 2>&1 || \
  die "pilo: picotool not found in PATH"

SUDO=""
if [ "${PILO_SUDO:-auto}" = "1" ]; then
  SUDO="sudo"
elif [ "${PILO_SUDO:-auto}" = "auto" ] && [ "$(uname -s)" = "Linux" ]; then
  SUDO="sudo"   # macOS does not need it
fi

TARGET=()
[ -n "${PILO_BUS:-}" ]     && TARGET+=(--bus "$PILO_BUS")
[ -n "${PILO_ADDRESS:-}" ] && TARGET+=(--address "$PILO_ADDRESS")

echo "pilo: loading $UF2"
$SUDO picotool load "$UF2" -x "${TARGET[@]+"${TARGET[@]}"}"
rc=$?

if [ $rc -ne 0 ]; then
  echo >&2
  echo "pilo: picotool failed (exit $rc)." >&2
  echo "      - is the board in BOOTSEL? (hold BOOT while plugging it in," >&2
  echo "        or double-tap reset: this build has pico_bootsel_via_double_reset)" >&2
  echo "      - several boards connected? pick one with:" >&2
  echo "        PILO_BUS=<bus> PILO_ADDRESS=<addr> pilo $ARG   (see picotool info -a)" >&2
  exit $rc
fi

echo "pilo: done"
