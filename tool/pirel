#!/usr/bin/env bash
#
# pirel - build the three variants and publish them as a GitHub release
#
#   usage: pirel <tag> [extra gh release create args...]
#          pirel v1.2.0
#          pirel v1.2.0-rc1 --prerelease
#          pirel v1.2.0 --draft --notes "hand written notes"
#
#   Without extra args the release notes are generated by GitHub.
#   The .uf2 files are taken from build/ after a fresh build.
#
#   For tagged releases prefer pushing the tag and letting
#   .github/workflows/release.yml build it: that build does not depend on
#   this machine. Use pirel when you want a release out now.
#
set -uo pipefail

VARIANTS="main_oil_t main_gearbox_t main_oil_p"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

die() { printf 'pirel: %s\n' "$*" >&2; exit 1; }

[ $# -ge 1 ] || die "usage: pirel <tag> [gh release create args...]"

case "$1" in
  -h|--help) awk 'NR==1&&/^#!/{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; exit 0 ;;
esac

TAG="$1"; shift

command -v gh >/dev/null 2>&1 || \
  die "gh not found - install the GitHub CLI, or push the tag and let Actions build it"
command -v cmake >/dev/null 2>&1 || die "cmake not found"
[ -n "${PICO_SDK_PATH:-}" ] || [ -n "${PICO_SDK_FETCH_FROM_GIT:-}" ] || \
  die "PICO_SDK_PATH is not set"

cd "$ROOT" || die "cannot cd to $ROOT"

# A release should describe a committed state.
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
  die "working tree is not clean - commit or stash first"
fi

echo "pirel: building $VARIANTS"
cmake -S . -B build -DCMAKE_BUILD_TYPE=Release >/dev/null || die "cmake configure failed"
cmake --build build --parallel                          || die "build failed"

FILES=()
for v in $VARIANTS; do
  [ -f "build/$v.uf2" ] || die "build/$v.uf2 was not produced"
  FILES+=("build/$v.uf2")
done

echo "pirel: publishing $TAG"
if [ $# -gt 0 ]; then
  gh release create "$TAG" "${FILES[@]}" --title "$TAG" "$@"
else
  gh release create "$TAG" "${FILES[@]}" --title "$TAG" --generate-notes
fi
rc=$?

[ $rc -eq 0 ] || die "gh release create failed (exit $rc)"
echo "pirel: done"
